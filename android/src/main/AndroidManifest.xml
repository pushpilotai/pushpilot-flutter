<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Gets FCM messages straight from Google Play services, next to Firebase's own receiver, so PushPilot
             pushes are shown even when the app is killed and no Dart code runs. -->
        <receiver
            android:name="ai.pushpilot.pushpilot_flutter.PushPilotMessageReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
        </receiver>

        <!-- Runs at process start, before the tap of a push that launches a killed app, to set the native link handler. -->
        <provider
            android:name="ai.pushpilot.pushpilot_flutter.PushPilotStartupProvider"
            android:authorities="${applicationId}.pushpilotstartupprovider"
            android:exported="false" />
    </application>
</manifest>
